List of Numbers

variable "ports" {
  type    = list(number)
  default = [22, 80, 443]
}

output "all_ports" {
  value = var.ports
}



---------------

Loop Through a List


variable "users" {
  type    = list(string)
  default = ["admin", "dev", "test"]
}

output "user_list" {
  value = [
    for user in var.users : user
  ]
}
----------------


Common List Functions

variable "names" {
  default = ["ram", "shyam", "mohan"]
}

output "first" {
  value = element(var.names, 0)
}

output "total" {
  value = length(var.names)
}

output "joined" {
  value = join(",", var.names)
}


output

first  = ram
total  = 3
joined = ram,shyam,mohan


