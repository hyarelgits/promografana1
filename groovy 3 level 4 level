Exercise 4: Parameterized Constructor
Groovy
class Employee {
 
String name
 
Employee(String name) {
this.name = name
}
 
void display() {
println name
}
}
 
Employee e = new Employee("Hyarel")
 
e.display()
Output
Plain Text
Hyarel
Exercise 5: Calculator Class
Groovy
class Calculator {
 
def add(a,b) {
return a+b
}
 
def sub(a,b) {
return a-b
}
}
 
Calculator c = new Calculator()
 
println c.add(10,20)
println c.sub(20,10)
Output
Plain Text
30
10
Exercise 6: Inheritance

Parent Class

Groovy
class Person {
 
void welcome() {
println "Welcome User"
}
}
 
class Employee extends Person {
 
}
 
Employee emp = new Employee()
 
emp.welcome()
Output
Plain Text
Welcome User
Exercise 7: Method Overriding
Groovy
class Animal {
 
void sound() {
println "Generic Sound"
}
}
 
class Dog extends Animal {
 
void sound() {
println "Bark"
}
}
 
Dog d = new Dog()
 
d.sound()
Output
Plain Text
Bark
Exercise 8: Encapsulation
Groovy
class Employee {
 
private String name
 
void setName(String name) {
this.name = name
}
 
String getName() {
return name
}
}
 
Employee e = new Employee()
 
e.setName("Hyarel")
 
println e.getName()
Output
Plain Text
Hyarel
