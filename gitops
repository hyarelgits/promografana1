name: demo
``

deployment.yaml

YAML
apiVersion: apps/v1
kind: Deployment
metadata:
name: nginx
namespace: demo
spec:
replicas: 2
 
selector:
matchLabels:
app: nginx
 
template:
metadata:
labels:
app: nginx
 
spec:
containers:
- name: nginx
image: nginx:1.25
 
ports:
- containerPort: 80
------------------------------
correct code

apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx
  namespace: demo

spec:
  replicas: 2

  selector:
    matchLabels:
      app: nginx

  template:
    metadata:
      labels:
        app: nginx

    spec:
      containers:
      - name: nginx
        image: nginx:1.25
        ports:
        - containerPort: 80




======================
service.yaml

YAML
apiVersion: v1
kind: Service
metadata:
name: nginx-service
namespace: demo
 
spec:
selector:
app: nginx
 
ports:
- port: 80
targetPort: 80
 
type: ClusterIP
``
